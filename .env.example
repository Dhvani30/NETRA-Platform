# NETRA environment configuration; keep real values only in an untracked .env file.
# Comma-separated enabled collectors: telegram, youtube, facebook, instagram, x, reddit, bluesky, mastodon.
ENABLED_SOURCES=
# MongoDB connection URI; may include credentials.
MONGO_URI=
# MongoDB database name.
DB_NAME=
# MongoDB raw-post collection name.
COLLECTION_NAME=
# Neo4j Bolt connection URI.
NEO4J_URI=
# Neo4j user name.
NEO4J_USER=
# Neo4j password.
NEO4J_PASSWORD=
# Telegram Bot API token.
TELEGRAM_BOT_TOKEN=
# Enable optional public Telegram-channel collection (0 or 1).
TELEGRAM_PUBLIC_ENABLED=
# Telegram MTProto application ID.
TELEGRAM_API_ID=
# Telegram MTProto application hash.
TELEGRAM_API_HASH=
# Telethon StringSession; never commit this value or a .session file.
TELEGRAM_SESSION=
# Comma-separated public Telegram channel handles.
TELEGRAM_CHANNELS=
# Maximum Telegram public messages per run.
TELEGRAM_PUBLIC_MAX_MESSAGES=
# YouTube Data API key.
YOUTUBE_API_KEY=
# Comma-separated YouTube search queries.
YOUTUBE_QUERIES=
# Comma-separated YouTube channel IDs.
YOUTUBE_CHANNEL_IDS=
# Daily YouTube API quota budget.
YOUTUBE_DAILY_QUOTA_BUDGET=
# Maximum YouTube comment pages per video.
YOUTUBE_MAX_COMMENT_PAGES=
# Meta Graph API Page access token.
META_ACCESS_TOKEN=
# Meta Facebook Page ID.
META_FACEBOOK_PAGE_ID=
# Instagram Login or Page access token.
INSTAGRAM_ACCESS_TOKEN=
# Instagram Business or Creator account ID.
INSTAGRAM_ACCOUNT_ID=
# Alternate Instagram account ID used as a fallback.
META_INSTAGRAM_ACCOUNT_ID=
# Meta Graph API version.
META_GRAPH_VERSION=
# Meta application ID.
META_APP_ID=
# Meta application secret.
META_APP_SECRET=
# Meta collector polling interval in seconds.
META_POLL_SECONDS=
# Maximum Meta API pages fetched per run.
META_MAX_PAGES=
# Meta comment lookback window in days.
META_COMMENT_LOOKBACK_DAYS=
# Meta webhook verification token.
META_WEBHOOK_VERIFY_TOKEN=
# Third-party X provider API key.
TWITTERAPI_IO_KEY=
# Comma-separated X search queries.
X_QUERIES=
# Maximum third-party X posts fetched per run.
X_TP_MAX_TWEETS_PER_RUN=
# Maximum third-party X result pages per run.
X_TP_MAX_PAGES=
# Daily third-party X post budget.
X_TP_DAILY_TWEET_BUDGET=
# Reddit API client ID.
REDDIT_CLIENT_ID=
# Reddit API client secret.
REDDIT_CLIENT_SECRET=
# Reddit API user-agent string.
REDDIT_USER_AGENT=
# Bluesky account handle.
BLUESKY_HANDLE=
# Bluesky app password.
BLUESKY_APP_PASSWORD=
# Maximum Bluesky posts per request.
BLUESKY_MAX_POSTS=
# Mastodon instance domain or domains.
MASTODON_INSTANCE=
# Mastodon OAuth access token.
MASTODON_TOKEN=
# Maximum Mastodon posts per request.
MASTODON_MAX_POSTS=
# Allow the Bluesky collector in addition to ENABLED_SOURCES (0 or 1).
ENABLE_BLUESKY=
# Allow the Mastodon collector in addition to ENABLED_SOURCES (0 or 1).
ENABLE_MASTODON=
# Allow the X collector in addition to ENABLED_SOURCES (0 or 1).
ENABLE_X=
# Allow the Reddit collector in addition to ENABLED_SOURCES (0 or 1).
ENABLE_REDDIT=
# Allow import of local datasets (0 or 1).
ENABLE_DATASET_IMPORT=
# Permit downloading NLP model assets at runtime (0 or 1).
NETRA_NLP_ALLOW_DOWNLOAD=
# Permit downloading trend-model assets at runtime (0 or 1).
NETRA_TRENDS_ALLOW_DOWNLOAD=
# Minimum group size used for k-anonymity.
K_ANON_MIN_GROUP=
# Public frontend API base URL.
VITE_API_BASE=
# Comma-separated browser origins permitted to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regular expression for preview origins, for example https://.*\\.vercel\\.app
CORS_ALLOWED_ORIGIN_REGEX=
# Frontend development server public URL.
FIGMA_PUBLIC_URL=
# Frontend development server bind host.
FIGMA_DEV_SERVER_HOST=
# Frontend development server port.
PORT=
# Optional ZenRows API key used by diagnostics or integrations.
ZENROWS_API_KEY=
